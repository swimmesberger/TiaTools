<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:edit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
        xmlns:local="clr-namespace:TiaViewer"
        x:Class="TiaViewer.MainWindow"
        x:DataType="local:MainWindow"
        Title="TIA Viewer" Width="1280" Height="820" MinWidth="700" MinHeight="400"
        DragDrop.AllowDrop="True">
    <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="8,6">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button x:Name="BackButton" Content="←" ToolTip.Tip="Back (Alt+Left)" IsEnabled="False" />
                <Button x:Name="ForwardButton" Content="→" ToolTip.Tip="Forward (Alt+Right)" IsEnabled="False" />
                <Button x:Name="OpenButton" Content="Open…" />
            </StackPanel>
            <TextBox x:Name="SearchBox" Grid.Column="1" Margin="12,0" MaxWidth="560"
                     PlaceholderText="Search all source, press Enter" />
            <TextBlock x:Name="Status" Grid.Column="2" VerticalAlignment="Center" Opacity="0.7" />
        </Grid>
        <Grid ColumnDefinitions="340,5,*">
            <DockPanel>
                <TextBox x:Name="TreeFilter" DockPanel.Dock="Top" Margin="8,0,4,6" PlaceholderText="Filter blocks by name" />
                <TreeView x:Name="Tree">
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate x:DataType="local:TreeRow" ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding Kind}" FontSize="11" Opacity="0.55" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Name}" />
                                <TextBlock Text="closed" FontSize="11" Opacity="0.55" VerticalAlignment="Center" IsVisible="{Binding IsClosed}" />
                            </StackPanel>
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                    <TreeView.Styles>
                        <Style Selector="TreeViewItem" x:DataType="local:TreeRow">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        </Style>
                    </TreeView.Styles>
                </TreeView>
            </DockPanel>
            <GridSplitter Grid.Column="1" ResizeDirection="Columns" />
            <Grid Grid.Column="2" RowDefinitions="Auto,*,5,230">
                <TextBlock x:Name="Heading" Margin="8,0,8,6" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <edit:TextEditor x:Name="Editor" Grid.Row="1" IsReadOnly="True" ShowLineNumbers="True" FontSize="13"
                                 FontFamily="Cascadia Mono,Consolas,Menlo,Monaco,monospace"
                                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                <TextBlock x:Name="Welcome" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"
                           TextAlignment="Center" Text="Open an archive or project, or drop it here.&#10;Nothing is changed, and protected source stays closed." />
                <GridSplitter Grid.Row="2" ResizeDirection="Rows" />
                <TabControl x:Name="Panels" Grid.Row="3" Padding="0">
                    <TabControl.Styles>
                        <Style Selector="TabItem">
                            <Setter Property="FontSize" Value="13" />
                            <Setter Property="MinHeight" Value="28" />
                            <Setter Property="Padding" Value="8,2" />
                        </Style>
                    </TabControl.Styles>
                    <TabItem x:Name="UsedByTab" Header="Used by">
                        <DockPanel>
                            <TextBlock x:Name="ClosedNote" DockPanel.Dock="Bottom" Margin="8,4" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                            <ListBox x:Name="UsedByList" />
                        </DockPanel>
                    </TabItem>
                    <TabItem x:Name="UsesTab" Header="Uses">
                        <ListBox x:Name="UsesList" />
                    </TabItem>
                    <TabItem x:Name="ResultsTab" Header="Search results">
                        <ListBox x:Name="ResultsList" />
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </DockPanel>

    <Window.DataTemplates>
        <DataTemplate x:DataType="local:PlaceRow">
            <Grid ColumnDefinitions="Auto,*">
                <TextBlock Text="{Binding Place}" FontWeight="SemiBold" Margin="0,0,12,0" />
                <TextBlock Grid.Column="1" Text="{Binding Text}" FontFamily="Cascadia Mono,Consolas,Menlo,Monaco,monospace" FontSize="12"
                           Opacity="0.75" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </Window.DataTemplates>
</Window>
