<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:edit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
        xmlns:local="clr-namespace:TiaViewer"
        x:Class="TiaViewer.MainWindow"
        x:DataType="local:MainWindow"
        Title="TIA Viewer" Width="1280" Height="820" MinWidth="700" MinHeight="400"
        Background="{DynamicResource Viewer.Source}"
        DragDrop.AllowDrop="True">
    <DockPanel>
        <!-- The window's menu, for where it is not shown at the top of the screen as on a Mac: there this hides itself. -->
        <NativeMenuBar DockPanel.Dock="Top" Background="{DynamicResource Viewer.Panel}" />
        <Border DockPanel.Dock="Top" Background="{DynamicResource Viewer.Panel}" BorderBrush="{DynamicResource Viewer.Line}"
                BorderThickness="0,0,0,1" Padding="8,6">
            <Grid ColumnDefinitions="Auto,*">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button x:Name="BackButton" Classes="tool" IsEnabled="False">
                        <Path Classes="icon" Data="{x:Static local:Glyphs.Back}" />
                    </Button>
                    <Button x:Name="ForwardButton" Classes="tool" IsEnabled="False">
                        <Path Classes="icon" Data="{x:Static local:Glyphs.Forward}" />
                    </Button>
                    <Border Width="1" Margin="6,4" Background="{DynamicResource Viewer.Line}" />
                    <Button x:Name="OpenButton" Classes="tool">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Classes="icon" Data="{x:Static local:Glyphs.Open}" />
                            <TextBlock Text="Open…" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ExportAllButton" Classes="tool" IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Classes="icon" Data="{x:Static local:Glyphs.Export}" />
                            <TextBlock Text="Export all…" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBox x:Name="SearchBox" Grid.Column="1" Margin="12,0" MaxWidth="560" Classes="clearButton"
                         PlaceholderText="Search all source, press Enter">
                    <TextBox.InnerLeftContent>
                        <Path Classes="icon" Margin="8,0,0,0" Stroke="{DynamicResource Viewer.Muted}" Data="{x:Static local:Glyphs.Search}" />
                    </TextBox.InnerLeftContent>
                </TextBox>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Viewer.Panel}" BorderBrush="{DynamicResource Viewer.Line}"
                BorderThickness="0,1,0,0" Padding="10,3">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto">
                <ProgressBar x:Name="Busy" IsIndeterminate="True" IsVisible="False" Width="80" MinWidth="0" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock x:Name="Status" Grid.Column="1" Classes="muted" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Button x:Name="ShowFolderButton" Grid.Column="2" Classes="tool" IsVisible="False" Margin="8,-3" Padding="6,1" FontSize="12" Content="Show folder" />
                <TextBlock x:Name="Hint" Grid.Column="4" Classes="muted" FontSize="12" Margin="16,0" VerticalAlignment="Center" />
                <TextBlock x:Name="CaretPlace" Grid.Column="5" Classes="muted" FontSize="12" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid ColumnDefinitions="310,1,*">
            <DockPanel Background="{DynamicResource Viewer.Panel}">
                <TextBox x:Name="TreeFilter" DockPanel.Dock="Top" Margin="8" Classes="clearButton" PlaceholderText="Filter blocks by name">
                    <TextBox.InnerLeftContent>
                        <Path Classes="icon" Margin="8,0,0,0" Stroke="{DynamicResource Viewer.Muted}" Data="{x:Static local:Glyphs.Filter}" />
                    </TextBox.InnerLeftContent>
                </TextBox>
                <!-- One switch per kind the tree holds, made when an archive opens: with none on, every kind is shown. -->
                <WrapPanel x:Name="KindSwitches" DockPanel.Dock="Top" Margin="6,-2,6,6" />
                <TreeView x:Name="Tree">
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate x:DataType="local:TreeRow" ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Spacing="6" Background="Transparent">
                                <StackPanel.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{Binding ExportLabel}" IsVisible="{Binding CanExport}" Click="OnExportRow">
                                            <MenuItem.Icon>
                                                <Path Classes="icon" Data="{x:Static local:Glyphs.Export}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{Binding CopyLabel}" IsVisible="{Binding IsItem}" Click="OnCopyRow">
                                            <MenuItem.Icon>
                                                <Path Classes="icon" Data="{x:Static local:Glyphs.Copy}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </StackPanel.ContextMenu>
                                <Path Classes="icon" IsVisible="{Binding IsHolder}" Data="{Binding Glyph}" Fill="{Binding GlyphFill}" Stroke="{Binding GlyphLine}" />
                                <local:KindBadge IsVisible="{Binding IsItem}" Kind="{Binding Kind}" Opacity="{Binding NameOpacity}" />
                                <TextBlock Text="{Binding Name}" Opacity="{Binding NameOpacity}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Number}" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                <Path Classes="icon small" IsVisible="{Binding IsProgramCycle}" Data="{x:Static local:Glyphs.Start}"
                                      Fill="{x:Static local:TreeRow.StartFill}" Stroke="{x:Static local:TreeRow.StartFill}" StrokeThickness="1"
                                      StrokeJoin="Round" ToolTip.Tip="Program cycle: the program starts here" />
                                <TextBlock Text="{Binding Count}" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                <Path Classes="icon small" IsVisible="{Binding IsClosed}" Data="{x:Static local:Glyphs.Lock}" ToolTip.Tip="Closed: know-how protected" />
                            </StackPanel>
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                    <TreeView.Styles>
                        <Style Selector="TreeViewItem" x:DataType="local:TreeRow">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        </Style>
                    </TreeView.Styles>
                </TreeView>
            </DockPanel>

            <Border Grid.Column="1" Background="{DynamicResource Viewer.Line}" />
            <GridSplitter Grid.Column="1" ResizeDirection="Columns" Margin="-3,0" MinWidth="0" Background="Transparent" ZIndex="1" />

            <Grid x:Name="SourceArea" Grid.Column="2" RowDefinitions="Auto,*,1,230">
                <Border x:Name="HeadingBar" BorderBrush="{DynamicResource Viewer.Line}" BorderThickness="0,0,0,1" Padding="12,8" IsVisible="False">
                    <!-- The name and its chips in one panel: a wider path below must not spread them apart. -->
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                        <StackPanel Orientation="Horizontal">
                            <local:KindBadge x:Name="HeadingBadge" Margin="0,0,8,0" />
                            <TextBlock x:Name="Heading" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Border x:Name="LanguageChip" Classes="chip" Margin="8,0,0,0">
                                <TextBlock x:Name="LanguageText" />
                            </Border>
                            <Border x:Name="ClosedChip" Classes="chip" Margin="6,0,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Path Classes="icon small" Width="11" Height="11" Data="{x:Static local:Glyphs.Lock}" />
                                    <TextBlock Text="closed" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Grid.RowSpan="2" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="CopyButton" Classes="tool" ToolTip.Tip="Copy this block's source">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path Classes="icon" Data="{x:Static local:Glyphs.Copy}" />
                                    <TextBlock Text="Copy" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ExportBlockButton" Classes="tool" ToolTip.Tip="Export this block as a file">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path Classes="icon" Data="{x:Static local:Glyphs.Export}" />
                                    <TextBlock Text="Export…" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="Breadcrumb" Grid.Row="1" Classes="muted" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>

                <edit:TextEditor x:Name="Editor" Grid.Row="1" IsReadOnly="True" ShowLineNumbers="True" FontSize="13"
                                 FontFamily="Cascadia Mono,Consolas,Menlo,Monaco,monospace"
                                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />

                <!-- A PLC's OPC UA configuration, shown in the editor's place. -->
                <local:OpcUaView x:Name="OpcUaPanel" Grid.Row="1" IsVisible="False" Background="{DynamicResource Viewer.Source}" />

                <!-- An HMI device's entry as a table (spec 0011), shown in the editor's place. -->
                <local:HmiView x:Name="HmiPanel" Grid.Row="1" IsVisible="False" Background="{DynamicResource Viewer.Source}" />

                <Border x:Name="PanelsLine" Grid.Row="2" Background="{DynamicResource Viewer.Line}" />
                <GridSplitter x:Name="PanelsSplitter" Grid.Row="2" ResizeDirection="Rows" Margin="0,-3" MinHeight="0" Background="Transparent" ZIndex="1" />

                <TabControl x:Name="Panels" Grid.Row="3" Padding="0">
                    <TabControl.Styles>
                        <Style Selector="TabItem">
                            <Setter Property="FontSize" Value="13" />
                            <Setter Property="MinHeight" Value="30" />
                            <Setter Property="Padding" Value="10,2" />
                        </Style>
                    </TabControl.Styles>
                    <TabItem x:Name="UsedByTab">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Classes="icon" Data="{x:Static local:Glyphs.UsedBy}" />
                                <TextBlock x:Name="UsedByHeader" Text="Used by" VerticalAlignment="Center" />
                                <Border Classes="chip"><TextBlock x:Name="UsedByCount" Text="0" /></Border>
                            </StackPanel>
                        </TabItem.Header>
                        <DockPanel>
                            <TextBlock x:Name="ClosedNote" DockPanel.Dock="Bottom" Classes="muted" Margin="10,4" FontSize="12" TextWrapping="Wrap" />
                            <ListBox x:Name="UsedByList" Classes="places" />
                        </DockPanel>
                    </TabItem>
                    <TabItem x:Name="UsesTab">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Classes="icon" Data="{x:Static local:Glyphs.Uses}" />
                                <TextBlock x:Name="UsesHeader" Text="Uses" VerticalAlignment="Center" />
                                <Border Classes="chip"><TextBlock x:Name="UsesCount" Text="0" /></Border>
                            </StackPanel>
                        </TabItem.Header>
                        <ListBox x:Name="UsesList" Classes="places" />
                    </TabItem>
                    <TabItem x:Name="ResultsTab">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Classes="icon" Data="{x:Static local:Glyphs.Search}" />
                                <TextBlock Text="Search results" VerticalAlignment="Center" />
                                <Border x:Name="ResultsChip" Classes="chip" IsVisible="False"><TextBlock x:Name="ResultsCount" /></Border>
                            </StackPanel>
                        </TabItem.Header>
                        <ListBox x:Name="ResultsList" Classes="places" />
                    </TabItem>
                </TabControl>

                <Border x:Name="Welcome" Grid.RowSpan="4" Background="{DynamicResource Viewer.Source}" ZIndex="2">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                        <Image x:Name="WelcomeIcon" Width="88" Height="88" Margin="0,0,0,6" />
                        <TextBlock x:Name="WelcomeTitle" Text="TIA Viewer" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock x:Name="WelcomeText" Classes="muted" TextAlignment="Center" HorizontalAlignment="Center" MaxWidth="460" TextWrapping="Wrap"
                                   Text="Read a PLC program without TIA Portal.&#10;Nothing is changed, and protected source stays closed." />
                        <Button x:Name="WelcomeOpen" Classes="accent" HorizontalAlignment="Center" Padding="14,6" Margin="0,8,0,0" Content="Open archive or project…" />
                        <TextBlock x:Name="WelcomeHint" Classes="muted" FontSize="12" HorizontalAlignment="Center" Text="or drop it here" />
                        <StackPanel x:Name="RecentPanel" Width="460" Margin="0,22,0,0" IsVisible="False">
                            <TextBlock Text="Recent" Classes="muted" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,4" />
                            <ItemsControl x:Name="RecentList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:RecentRow">
                                        <Button Classes="tool" Click="OnRecentClick" ToolTip.Tip="{Binding Path}" Padding="8,4"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Folder}" Classes="muted" FontSize="11" TextTrimming="PathSegmentEllipsis" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>

    <Window.DataTemplates>
        <DataTemplate x:DataType="local:PlaceRow">
            <Grid ColumnDefinitions="Auto,Auto,280,48,*">
                <TextBlock Text="{Binding Verb}" Classes="verb" Classes.call="{Binding IsCall}" IsVisible="{Binding HasVerb}" Width="30" FontSize="12" VerticalAlignment="Center" />
                <local:KindBadge Grid.Column="1" Kind="{Binding Kind}" Margin="0,0,8,0" />
                <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="3" Text="{Binding At}" Classes="muted" FontSize="12" TextAlignment="Right" Margin="0,0,14,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="{Binding Text}" FontFamily="Cascadia Mono,Consolas,Menlo,Monaco,monospace" FontSize="12"
                           Classes="muted" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </Window.DataTemplates>
</Window>
