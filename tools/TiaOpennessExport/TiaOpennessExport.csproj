<Project Sdk="Microsoft.NET.Sdk">
    <!-- Kept out of TiaTools.slnx: it needs TIA Portal's Openness assemblies, so the solution still builds without TIA. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net48</TargetFramework>
        <PlatformTarget>x64</PlatformTarget>
        <LangVersion>latest</LangVersion>
        <Nullable>disable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <EnableNETAnalyzers>false</EnableNETAnalyzers>
        <TiaPublicApi Condition="'$(TiaPublicApi)' == ''">C:\Program Files\Siemens\Automation\Portal V21\PublicAPI\V21\net48</TiaPublicApi>
    </PropertyGroup>
    <ItemGroup>
        <Reference Include="Siemens.Engineering.Base">
            <HintPath>$(TiaPublicApi)\Siemens.Engineering.Base.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Siemens.Engineering.Safety">
            <HintPath>$(TiaPublicApi)\Siemens.Engineering.Safety.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Siemens.Engineering.Step7">
            <HintPath>$(TiaPublicApi)\Siemens.Engineering.Step7.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Siemens.Engineering.WinCC">
            <HintPath>$(TiaPublicApi)\Siemens.Engineering.WinCC.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Siemens.Engineering.WinCCUnified">
            <HintPath>$(TiaPublicApi)\Siemens.Engineering.WinCCUnified.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>
</Project>
