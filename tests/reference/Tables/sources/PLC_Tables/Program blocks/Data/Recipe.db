DATA_BLOCK "Recipe"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
   VAR
      active : Bool;   // A recipe runs
      count : Int;   // Cycles run
      steps : Array[1..3] of "RecipeStep";
      limits : Struct
         low : Int;
         high : Int;
      END_STRUCT;
   END_VAR


BEGIN
   limits.high := 90;
END_DATA_BLOCK
