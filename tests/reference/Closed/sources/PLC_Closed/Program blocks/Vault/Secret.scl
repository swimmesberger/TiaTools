FUNCTION_BLOCK "Secret"
TITLE = A block that is know-how protected
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
//Its interface may stay readable; nothing of its body may appear anywhere the reader shows.
   VAR_INPUT
      seed : DInt;   // What goes in
   END_VAR

   VAR_OUTPUT
      answer : DInt;   // What comes out
   END_VAR

   VAR
      kept : DInt;
   END_VAR


BEGIN
	// CLOSED-MARKER-7Q2X body comment that must never be shown
	#kept := #seed * 7919 + 104729;
	#answer := #kept MOD 15485863;
	IF #answer = 31337 THEN
	    #kept := 0;
	END_IF;
END_FUNCTION_BLOCK

