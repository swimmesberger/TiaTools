FUNCTION "Classic" : Void
TITLE = Classic statement list
{ S7_Optimized_Access := 'FALSE' }
VERSION : 0.1
//An S5 timer, a counter, absolute addresses and a data block opened by number.
   VAR_INPUT 
      start : Bool;
   END_VAR

   VAR_OUTPUT 
      elapsed : Bool;
      parts : Word;
   END_VAR


BEGIN
NETWORK
TITLE = An on-delay timer
      A #start;
      L S5T#2S;
      SD "Tag__639308646888752274";
      A "Tag__639308646888752274";
      = #elapsed;
NETWORK
TITLE = A counter
      A "Tag__639308646889222918";
      CU "Tag__639308646889222919";
      A "Tag__639308646889222920";
      R "Tag__639308646889222919";
      L "Tag__639308646889222919";
      T #parts;
NETWORK
TITLE = A data block by number
      OPN "Store";
      L %DBW2;
      T "Tag__639308646889546626";
      L "Store".count;
      T "Tag__639308646889705153";
END_FUNCTION

