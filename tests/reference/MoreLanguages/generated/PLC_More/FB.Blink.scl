FUNCTION_BLOCK "Blink"
TITLE = Blinker
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
//Toggles its output on every call while enabled.
   VAR_INPUT 
      enable : Bool;
   END_VAR

   VAR_OUTPUT 
      q : Bool;
   END_VAR


BEGIN
	
	 IF #enable THEN
	     #q := NOT #q;
	 ELSE
	     #q := FALSE;
	 END_IF;
	
END_FUNCTION_BLOCK

