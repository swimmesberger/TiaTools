FUNCTION_BLOCK "Station"
TITLE = Station with 2 pumps
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      run : Bool;   // Run the station
   END_VAR

   VAR 
      pump1 : "Pump";   // Pump 1 of 2
      pump2 : "Pump";   // Pump 2 of 2
   END_VAR


BEGIN
	#pump1(run := #run);
	#pump2(run := #run);
END_FUNCTION_BLOCK

